Replica of Soliman (2025) Fig.1 design - Bo (Boron) target - FISSION spectrum (U-235 Watt) - v2 (2cm cell, T-Track, sinh tu dong)
$ Doi chieu voi: sigma_R(fission,B)=1.049 barns/atom ; Sigma_R/rho(fission,B)=0.0584 cm2/g (Table 2,3 bai bao)

$OMP=40

[ Parameters ]
icntl    = 0
nucdata  = 1
maxcas   = 1000000    $ TANG so hat de dam bao thong ke du o cac lop xa (r~120cm), voi 45 lop 2cm
maxbch   = 1
file(6)  = phits_b_fission.out

[ Source ]
$ Vo cau nguon r=10cm, phat theo PHO PHAN HACH WATT U-235 (khong phai Cf-252!)
totfact  = 1.0
s-type   = 9
x0       = 0.0
y0       = 0.0
z0       = 0.0
r1       = 10.001   $ ban kinh TRONG cua vo cau nguon - lech nhe khoi bien de tranh surface-skimming
r2       = 10.001   $ ban kinh NGOAI = r1 -> nguon la mat cau mong (surface source)
dir      = 1        $ cosine=1 tuong doi voi phap tuyen huong ra ngoai tu tam cau
proj     = neutron

$ Pho Watt U-235 (fission) - GIA TRI a,b PHO BIEN TRONG GIAO TRINH, KHONG PHAI SO LIEU GOC CUA BAI BAO
e-type = 5
eg1    = 0.01
eg2    = 15.0
nm     = 200
set: c1[0.988]
set: c2[2.249]
f(x) = exp(-x/c1)*sinh(sqrt(c2*x))


[ Material ]
$ Nuoc - moi truong hydrogenous (giong bai bao dung "FLUKA predefined water")
m1    1001.50c  -0.1119   $ H-1
      8016.50c  -0.8881   $ O-16
mt1   lwtr.20t



$ Bo (Boron) tu nhien - vat lieu target can khao sat (Z=5)
$ Thanh phan dong vi tu nhien (atomic %): B-10 19.9000%, B-11 80.1000%
m2    5010.50c   0.19900   $ B-10
      5011.50c   0.80100   $ B-11



